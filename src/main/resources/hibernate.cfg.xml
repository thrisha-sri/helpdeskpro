<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "https://hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>

        <!-- Database connection -->
        <property name="hibernate.connection.driver_class">
            com.mysql.cj.jdbc.Driver
        </property>

        <property name="hibernate.connection.url">
            jdbc:mysql://localhost:3306/helpdeskpro
        </property>
        

      <property name="hibernate.hikari.username">${env.HELPDESK_DB_USERNAME}</property>
<property name="hibernate.hikari.password">${env.HELPDESK_DB_PASSWORD}</property>
 <!-- HikariCP connection pool -->
        <property name="hibernate.connection.provider_class">
            org.hibernate.hikaricp.internal.HikariCPConnectionProvider
        </property>

        <property name="hibernate.hikari.maximumPoolSize">10</property>
        <property name="hibernate.hikari.minimumIdle">2</property>

        <!-- Display SQL in console -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">false</property>

        <!-- We'll manage table creation after mapping entities -->
        <property name="hibernate.hbm2ddl.auto">validate</property>

    </session-factory>
</hibernate-configuration>
